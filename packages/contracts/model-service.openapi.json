{
  "components": {
    "schemas": {
      "EmbedRequest": {
        "additionalProperties": false,
        "properties": {
          "input_type": {
            "description": "Queries and passages may be encoded differently by the model.",
            "enum": [
              "query",
              "passage"
            ],
            "title": "Input Type",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Expected model name; the request fails if another model is loaded.",
            "title": "Model"
          },
          "texts": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Texts",
            "type": "array"
          }
        },
        "required": [
          "input_type",
          "texts"
        ],
        "title": "EmbedRequest",
        "type": "object"
      },
      "EmbedResponse": {
        "properties": {
          "dimensions": {
            "title": "Dimensions",
            "type": "integer"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "string"
          },
          "vectors": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Vectors",
            "type": "array"
          }
        },
        "required": [
          "model",
          "revision",
          "dimensions",
          "vectors"
        ],
        "title": "EmbedResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ModelInfo": {
        "properties": {
          "dimensions": {
            "title": "Dimensions",
            "type": "integer"
          },
          "license": {
            "title": "License",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "query_prefix": {
            "title": "Query Prefix",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "string"
          },
          "task": {
            "const": "embedding",
            "title": "Task",
            "type": "string"
          }
        },
        "required": [
          "name",
          "task",
          "revision",
          "dimensions",
          "query_prefix",
          "license"
        ],
        "title": "ModelInfo",
        "type": "object"
      },
      "ModelsResponse": {
        "properties": {
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelInfo"
            },
            "title": "Models",
            "type": "array"
          }
        },
        "required": [
          "models"
        ],
        "title": "ModelsResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Grounded Access model service",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/v1/embed": {
      "post": {
        "operationId": "embed_v1_embed_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Embed"
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "models_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Models"
      }
    }
  }
}
