{
  "components": {
    "schemas": {
      "EmbedRequest": {
        "additionalProperties": false,
        "properties": {
          "input_type": {
            "description": "Queries and passages may be encoded differently by the model.",
            "enum": [
              "query",
              "passage"
            ],
            "title": "Input Type",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Expected model name; the request fails if another model is loaded.",
            "title": "Model"
          },
          "texts": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Texts",
            "type": "array"
          }
        },
        "required": [
          "input_type",
          "texts"
        ],
        "title": "EmbedRequest",
        "type": "object"
      },
      "EmbedResponse": {
        "properties": {
          "dimensions": {
            "title": "Dimensions",
            "type": "integer"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "string"
          },
          "vectors": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Vectors",
            "type": "array"
          }
        },
        "required": [
          "model",
          "revision",
          "dimensions",
          "vectors"
        ],
        "title": "EmbedResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ModelInfo": {
        "properties": {
          "dimensions": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Vector size; embedding models only.",
            "title": "Dimensions"
          },
          "license": {
            "title": "License",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "query_prefix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Instruction prepended to queries; embedding models only.",
            "title": "Query Prefix"
          },
          "revision": {
            "title": "Revision",
            "type": "string"
          },
          "task": {
            "enum": [
              "embedding",
              "rerank"
            ],
            "title": "Task",
            "type": "string"
          }
        },
        "required": [
          "name",
          "task",
          "revision",
          "license"
        ],
        "title": "ModelInfo",
        "type": "object"
      },
      "ModelsResponse": {
        "properties": {
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelInfo"
            },
            "title": "Models",
            "type": "array"
          }
        },
        "required": [
          "models"
        ],
        "title": "ModelsResponse",
        "type": "object"
      },
      "Passage": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Opaque to the service; returned with the score so the caller can match it.",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "title": "Passage",
        "type": "object"
      },
      "PassageScore": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "score": {
            "description": "Relevance of the passage to the query; higher is more relevant. Only comparable within one response.",
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "id",
          "score"
        ],
        "title": "PassageScore",
        "type": "object"
      },
      "RerankRequest": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Expected model name; the request fails if another model is loaded.",
            "title": "Model"
          },
          "passages": {
            "items": {
              "$ref": "#/components/schemas/Passage"
            },
            "minItems": 1,
            "title": "Passages",
            "type": "array"
          },
          "query": {
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query",
          "passages"
        ],
        "title": "RerankRequest",
        "type": "object"
      },
      "RerankResponse": {
        "properties": {
          "model": {
            "title": "Model",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "string"
          },
          "scores": {
            "description": "One entry per passage, in request order.",
            "items": {
              "$ref": "#/components/schemas/PassageScore"
            },
            "title": "Scores",
            "type": "array"
          }
        },
        "required": [
          "model",
          "revision",
          "scores"
        ],
        "title": "RerankResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Grounded Access model service",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/v1/embed": {
      "post": {
        "operationId": "embed_v1_embed_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Embed"
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "models_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Models"
      }
    },
    "/v1/rerank": {
      "post": {
        "description": "Scores each passage against the query. The service does not sort or drop passages: ordering and cut-off belong to the caller,\nwhich also decides what happens when this call fails.",
        "operationId": "rerank_v1_rerank_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RerankRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RerankResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Rerank"
      }
    }
  }
}
